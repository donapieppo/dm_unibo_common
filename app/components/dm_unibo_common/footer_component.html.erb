<footer class="footer-wrapper text-white bg-primary mt-auto">
  <div class="container pt-5">
    <div class="footer-box p-4">
      <div class="row">
        <div class="col-12">
          <div class="d-flex align-items-start gap-3">
            <%= dm_icon :headset, size: "2xl" %>
            <i class="bi bi-headset display-5 lh-1" aria-hidden="true"></i>
            <div>
              <div class="mb-1">
                <h6 class="fw-bold d-inline mb-0">Per assistenza o errori durante l'accesso al servizio</h6>
                <span> &ndash; <%= @contact_description %></span>
              </div>
              <ul class="list-unstyled d-flex flex-column flex-sm-row column-gap-4 row-gap-1 mb-1">
                <% unless @contact_mail.blank? %>
                  <li><strong>E-mail:</strong> <a href="mailto:<%= @contact_mail %>" class="text-white"><%= @contact_mail %></a></li>
                <% end %>
                <% unless @contact_tel.blank? %>
                  <li><strong>Tel:</strong> <a href="tel:<%= @contact_tel %>" class="text-white"><%= @contact_tel %></a></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <div class="copyright pt-3 mt-3 text-center small">
        &copy; <%= Time.current.year %> - <%= @footer_copyright %>
        - <%= link_to "Informativa sulla Privacy", @privacy_url, class: "text-light" %>
      </div>
    </div>
  </div>
</footer>
