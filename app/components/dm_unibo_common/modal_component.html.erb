<% if modal_page? %>
  <turbo-frame id="modal">
    <%= tag.div data: { controller: "turbo-modal", action: @actions } do %>
      <%= tag.div(**modal_attributes) do %>
        <div id="modal_dialog" class="modal-dialog modal-<%= @size %> modal-dialog-centered">
          <div id="modal_content" class="modal-content position-relative" data-turbo-modal-target="modalContent">
            <div class="position-absolute top-0 start-100 translate-middle p-2">
              <%= button_tag "Chiudi", type: :button, data: { action: "turbo-modal#hideModal" }, class: "btn btn-success btn-sm" %>
            </div>
            <% unless @title.blank? %>
              <div class="modal-header">
                <h2 id="modal_title"><%= @title %></h2>
              </div>
            <% end %>
            <div class="modal-body">
              <%= content %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </turbo-frame>
<% else %>
  <% unless @title.blank? %>
    <h1><%= @title %></h1>
  <% end %>

  <%= content %>
<% end %>
