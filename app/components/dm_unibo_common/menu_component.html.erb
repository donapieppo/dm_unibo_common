<div role="navigation" aria-label="scorciatoie per la navigazione">
  <a href="#content" class="visually-hidden-focusable btn btn-primary btn-sm" accesskey="c">
    Vai al contenuto
  </a>
  <a href="#mainmenu" class="visually-hidden-focusable btn btn-primary btn-sm" accesskey="m">
    Vai al menu di navigazione
  </a>
</div>

<header class="d-flex align-items-end align-items-sm-center justify-content-between position-relative shadow-sm bg-primary text-white px-3">
  <div class="d-flex align-items-center">
    <!-- Logo per schermi extra small (mobile) -->
    <% if Rails.root.join("app/assets/images", sigil_vertical).exist? %>
      <%= image_tag sigil_vertical, height: 75, alt: "Logo Università di Bologna", class: "d-block d-lg-none my-2 mx-sm-2" %>
    <% end %>
    <!-- Logo per schermi small (tablet) e superiori -->
    <% if Rails.root.join("app/assets/images", sigil_horizontal).exist? %>
      <%= image_tag sigil_horizontal, height: 50, alt: "Logo Università di Bologna", class: "my-2 d-none d-lg-block mx-2 px-3" %>
    <% end %>

    <!-- Titolo (mobile) -->
    <span class="h3 d-sm-none mx-2">
      <%= @header_title %>
      <% if @tag %>
        <span class="badge bg-white text-primary hpc-badge-beta"><%= @tag %></span>
      <% end %>
    </span>
  </div>

  <!-- Titolo centrato (desktop) -->
  <span class="h2 position-absolute start-50 translate-middle-x d-none d-sm-block">
    <%= @header_title %>
    <% if @tag %>
      <span class="badge bg-white text-primary hpc-badge-beta fs-6"><%= @tag %></span>
    <% end %>
  </span>
</header>

<% if @sso_user_upn %>

  <nav aria-label="Navigazione principale HPC" class="navbar navbar-light navbar-expand-md bg-white shadow-sm px-2 px-md-4" id="mainmenu">
    <div class="container-fluid">
      <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenuLinksHpc" aria-controls="mainMenuLinksHpc" aria-expanded="false" aria-label="Apri il menu principale">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="d-flex align-items-center order-0 order-sm-1">
        <a href="#" class="link-dark text-decoration-none dropdown-toggle" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
          <i aria-hidden="true" class="bi bi-person-fill"></i> <span class="d-none d-sm-inline"><%= @sso_user_upn %></span>
          <span class="visually-hidden">Menu utente <%= @sso_user_upn %></span>
        </a>
        <ul class="dropdown-menu text-small dropdown-menu-end" aria-labelledby="userMenu">
          <li>
            <%= link_to dm_unibo_common.logout_path, data: {turbo: false}, class: "dropdown-item text-danger" do %>
              <%= dm_icon("sign-out", text: "Logout") %>
            <% end %>
          </li>
        </ul>
      </div>

      <div class="collapse navbar-collapse" id="mainMenuLinksHpc">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <%= content %>
        </ul>

        <% if @search_component %>  
          <%= render @search_component %>  
        <% end %>

      </div>
    </div>
  </nav>
<% end %>
