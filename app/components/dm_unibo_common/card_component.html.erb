<div class="card my-3 <%= @css_class %>">
  <div class="card-body">
    <% if @icon || !@title.blank? %>
      <div class="card-title text-primary fw-semibold">
        <% if @icon %>
          <span class="pe-1"><%= dm_icon(@icon) %></span>
        <% end %>
        <%= @title %>
      </div>
    <% end %>

    <%= content %>
  </div>
</div>
